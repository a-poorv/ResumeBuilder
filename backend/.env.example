# Server
PORT=3000

# Groq — required for resume parse + generate
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase — optional. History/dashboard survive restarts when set.
# 1) Create a project at https://supabase.com
# 2) Run backend/supabase/schema.sql in SQL Editor
# 3) Project Settings → API: paste URL + service_role key (server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Comma-separated browser origins allowed to call the API (Vercel + local)
FRONTEND_ORIGIN=http://localhost:5173
